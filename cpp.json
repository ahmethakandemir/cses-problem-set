	"fast pow": {
		"prefix": "fpow",
		"body": [
			"int fpow(int a, int b) {",
			"    if (b == 0) return 1;",
			"    int u = fpow(a, b / 2);",
			"    u = (u * u) % MOD;",
			"    if (b & 1) u = (u * a) % MOD;",
			"    return u;",
			"}"
		],
		"description": "Recursive fast power"
	}
