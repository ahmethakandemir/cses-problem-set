	"Segment Tree": {
		"prefix": "sup_segmeent_tree",
		"body": [
			"class SegmentTree {",
			"private:",
			"\tint n;",
			"\tvector<int> a;",
			"\tint combine(int a, int b) {",
			"\t\treturn a + b;",
			"\t}",
			"\t",
			"public:",
			"\tSegmentTree(int size) : n(size), a(2*size) {}",    
			"\t",
			"\tvoid build(const vector<int>& arr) {",
			"\t\tfor (int i = 0; i < n; ++i) a[n + i] = arr[i];", 
			"\t\tfor (int i = n - 1; i > 0; --i)",
			"\t\t\ta[i] = combine(a[i << 1], a[i << 1 | 1]);",    
			"\t}",
			"\t",
			"\tvoid modify(int p, int value) {",
			"\t\tfor (a[p += n] = value; p > 1; p >>= 1)",        
			"\t\t\ta[p >> 1] = combine(a[p], a[p ^ 1]);",
			"\t}",
			"\t",
			"\tint query(int l, int r) {",
			"\t\tint res = 0;",
			"\t\tfor (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
			"\t\t\tif (l & 1) res = combine(res, a[l++]);",       
			"\t\t\tif (r & 1) res = combine(res, a[--r]);",       
			"\t\t}",
			"\t\treturn res;",
			"\t}",
			"};"
		],
		"description": "Segment Tree"
	},

	"Fenwick Tree": {
	"prefix": "sup_fenwick_tree",
	"body": [
		"class FenwickTree {",
		"public:",
		"    int n;",
		"    vi fw;",
		"    FenwickTree(int sz) : n(sz), fw(sz+1, 0) {}",
		"",
		"    void add(int i, int x) {",
		"        assert(0 <= i && i <= n);",
		"        while (i <= n) {",
		"            fw[i] += x;",
		"            i += i&-i;",
		"        }",
		"    }",
		"",
		"    void start(vi& v) {",
		"        assert(v.size() == n);",
		"        f(i,0,n) add(i, v[i]);",
		"    }",
		"",
		"    int sum(int i) {",
		"        assert(0 <= i && i <= n);",
		"        int s = 0;",
		"        while (i >= 1) {",
		"            s += fw[i];",
		"            i -= i&-i;",
		"        }",
		"        return s;",
		"    }",
		"",
		"    int query(int l, int r) {",
		"        assert(l <= r);",
		"        return sum(r) - sum(l-1);",
		"    }",
		"};"
	],
	"description": "Fenwick Tree"
	},
	
